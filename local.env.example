# Copy to local.env (gitignored) and adjust:  cp local.env.example local.env
#
# There is deliberately NO committed env file. Make variables override the
# environment, so a committed `export DISCORD_TOKEN=` would silently clobber
# whatever you exported in your shell — a trap worth not shipping.
# The bot token is never stored here, only the TeamVault key it is fetched from.

# Discord. The token itself is NEVER stored here — only the TeamVault key it is
# fetched from at run time (see the run target), matching go-skeleton's
# SENTRY_DSN_KEY pattern.
#
# Never add a secret to this file: Make `include`s it, and Make variables
# override the environment, so even an empty `export DISCORD_TOKEN=` here would
# silently clobber whatever you exported in your shell.
export DISCORD_TOKEN_KEY=aL5p3O
export ALLOWED_USER_IDS=197830250418274304

# Who may use the SLASH commands (session and voice control). A subset of
# ALLOWED_USER_IDS — everyone allowed keeps the @mention surface either way.
# Empty means no admins, never all of them.
export ADMIN_USER_IDS=197830250418274304

# Which guilds advertise slash commands at all. Empty = every guild the bot is
# in. Set it when the bot is in a guild where you are an ordinary member:
# Discord's visibility gate is permission-based, so a command gated on
# ManageGuild would be hidden from YOU there too, and advertising commands
# nobody present may use is worse than advertising none.
# export SLASH_COMMAND_GUILD_IDS=

# Shape of the slash-command surface. multi (default) = every command top-level,
# hidden behind Manage Server. single = one /ben command with subcommands,
# visible to every member; ADMIN_USER_IDS still decides who may use it.
# export SLASH_COMMAND_MODE=single

# The swappable endpoint: MiniMax, or the Claude Code shim
export OPENAI_BASE_URL=http://127.0.0.1:8080/v1
export OPENAI_API_KEY=not-needed
export OPENAI_MODEL=claude-code

# speech-to-speech realtime socket (voice surface).
#
# This is the GATEWAY's address, not s2s's. The gateway (component `gateway`,
# nginx) owns the only 0.0.0.0 bind and checks the token; s2s itself stays on
# 127.0.0.1:8765 and is never addressed directly by the bot.
#
# The `?token=` value is appended at launch by scripts/launchd-run.sh from
# S2S_GATEWAY_TOKEN_KEY below — never written here. Leave this as the bare URL.
# Pointing it back at 8765 directly would bypass auth entirely; on a
# single-machine setup that still "works", which is exactly why it is worth
# stating: it works until the moment the port is reachable from elsewhere.
export S2S_URL=ws://127.0.0.1:8766/v1/realtime

# Shared secret gating the s2s gateway. A TeamVault key id, never the token
# itself — same rule as DISCORD_TOKEN_KEY and CHAT_BRIDGE_TOKEN_KEY.
#
# Resolved independently by TWO components (each its own resolution, not a
# shared variable): the gateway checks it, the bot presents it as the ?token=
# query param. Both read this one key id.
export S2S_GATEWAY_TOKEN_KEY=QL3RpO

# Voice capability. Default true. Set to 0 for a text-only instance: no
# join/leave slash commands, no connection to S2S_URL. Required wherever there
# is no GPU for speech-to-speech — which is every cluster node.
#export VOICE_ENABLED=0

# Force the wake phrase even in a solo call. Default off (an instance with
# nothing set answers unaddressed speech when it is alone, as before). Set to 1
# for an instance that must never auto-answer, e.g. the Star Citizen Assistant
# on a friends' server. Read by BOTH the bot and the shim; voice stays fully
# enabled, only the solo auto-answer is switched off.
#export VOICE_ALWAYS_WAKE=1

# How long an EMPTY voice channel keeps the session (and its s2s slot) after the
# last human leaves, before the bot leaves too. Default 1h. Named for the empty
# room, not for silence: the trigger is an empty channel, so talking to yourself
# indefinitely never releases the bot while walking out does. This is the
# "empty-room timeout" half of the leave contract: the only other ways the bot
# leaves a call are /leave and a yield to another identity, and every other
# disconnect rejoins the same channel automatically.
#
# `VOICE_IDLE_RELEASE_MS` is still accepted as a fallback so an existing
# local.env keeps working — the old name said "idle" and misled exactly as above.
# export VOICE_EMPTY_ROOM_RELEASE_MS=3600000

# Auto-rejoin backoff after a disconnect nobody asked for. Delays double from
# VOICE_REJOIN_BASE_MS, capped at VOICE_REJOIN_MAX_DELAY_MS, for at most
# VOICE_REJOIN_MAX_ATTEMPTS attempts; after that the bot logs `voice: rejoin
# abandoned` at ERROR and stays out. The defaults (2s, 60s cap, 5 attempts =
# 2+4+8+16+32s) never reach the cap — it exists so raising the attempt count
# cannot produce an unbounded wait.
# export VOICE_REJOIN_BASE_MS=2000
# export VOICE_REJOIN_MAX_DELAY_MS=60000
# export VOICE_REJOIN_MAX_ATTEMPTS=5

# Where the bot writes down the call it is currently in, so a restart can rejoin
# it. A restart is not a disconnect the running process can repair — it is gone
# before it can react — so keeping "leaves only on /leave, an empty-room timeout, or a
# yield" true across one means persisting the call and restoring it at boot.
# Cleared on every call-ending leave, preserved on shutdown and on a rejoin's own
# pre-cleanup, and ignored at boot when the channel is empty — a record outlives
# the call it describes. Default: the identity is part of the filename
# (~/.local/state/discord-assistant/live-call-<identity>.json) because several
# bots share one $HOME and must not read each other's record; under the home
# directory rather than /tmp because a reboot must not erase it.
# export VOICE_STATE_PATH=/Users/you/.local/state/discord-assistant/live-call-personal.json

# Which Discord identity THIS bot is (personal, sc, boss, ...) — not which
# guild it serves. Unset reproduces the single-identity v0.16.0 behaviour
# exactly. Set it to give this bot its own persona in config.yaml's
# `identities:` block, keyed by this same name, regardless of how many
# guilds it serves or shares with another identity.
#export IDENTITY=sc

# Service
export HEALTH_HOST=0.0.0.0
export HEALTH_PORT=8081   # 8080 is the shim; avoid the collision
export LOG_LEVEL=info
export SHUTDOWN_TIMEOUT_MS=10000
export HISTORY_LIMIT=20

# Chat bridge: lets the shim post a spoken answer's full text back into the
# live voice call's channel (src/health.js POST /chat). Read by BOTH the bot
# (src/config.js) and the shim (claude_openai_shim.py) under the SAME name,
# CHAT_BRIDGE_TOKEN — the launcher resolves this key id once and exports that
# name to the components that need it. Never pass the value by argv.
#
# A TeamVault key id, never the token itself — same rule as DISCORD_TOKEN_KEY
# and FRONT_API_KEY_ID above. This file used to carry the literal as the one
# documented exception, which put a real shared secret in every checkout's
# local.env in a public repo. It is no longer an exception.
#
# Every identity talking to the same shim must point at the SAME key id: the
# bot and the shim authenticate to each other with the resolved value, so two
# identities on different ids cannot bridge.
export CHAT_BRIDGE_TOKEN_KEY=8q10WL

# Docker / Kubernetes
#
# These describe the K8S DEPLOY TARGET, and the k8s Makefile SOURCES this file
# inside its `apply` recipe. That makes them load-bearing in a way a normal env
# file is not: these values — not a `make VAR=` override — decide which registry
# the manifests render against (`{{"DOCKER_REGISTRY" | env}}`) and which context
# `kubectl --context` uses. An override retargets build+upload but NOT apply, so
# the image lands in one registry while the Deployment still names another and
# the pods go ImagePullBackOff. It also has to be present: the recipe's `source`
# runs under `&&`, so a missing local.env aborts the apply entirely.
#
# Defaults below are the live star-citizen deployment on nuke-dev. A `-prod`
# checkout sets CLUSTER_CONTEXT=nuke-prod, ROUTER_NS=prod and the matching
# ROUTER_HOST; the deploy worktrees `discord-assistant-sc-dev` / `-prod` hold
# exactly those. KUBECONFIG is not set here — pass it per deploy
# (`KUBECONFIG=$HOME/.kube/nuke-dev make buca`), since the wrapper is just
# `KUBECONFIG=$HOME/.kube/<cluster> command kubectl "$@"`.
# (Verified against both clusters 2026-09-20.)
export DOCKER_REGISTRY=docker.prod.nuke.benjamin-borbe.de:443
export CLUSTER_CONTEXT=nuke-dev
export NAMESPACE=star-citizen
export ROUTER_NS=dev
export ROUTER_HOST=http://claude-code-router-dev.dev.svc.cluster.local:8788

# Build metadata (set by CI/CD)
export BUILD_GIT_VERSION=dev
export BUILD_GIT_COMMIT=none
export BUILD_DATE=unknown

# Where voice transcripts land. Must be readable by the shim, which runs
# Claude Code with cwd in the vault — so keep it inside the vault.
export TRANSCRIPT_DIR="$HOME/Documents/Obsidian/Personal/70 Source Material/Discord"
# export TRANSCRIBE=0              # disable transcription entirely
# export ANNOUNCE_TRANSCRIPTION=0  # join without saying it is recording

# Wake phrases for VOICE turns, comma-separated, matched as a PREFIX and
# case-insensitively. In a call the assistant hears everything an allowlisted
# speaker says, so without this it answers conversations meant for other people.
# The extra entries are speech-to-text mishearings of the first one — add the
# ones your own transcripts show, and remember each is a false-trigger risk.
# Empty disables the gate entirely (answers every utterance, the old behaviour).
# Typed messages are never gated: an @mention already addressed the bot.
export SHIM_WAKE_PHRASES="hey bot,hey bought,hey but,hi bot"

# Should speaking while the assistant is answering CANCEL that answer?
# Off by default (reverses speech-to-speech's own default). The cancel fires on
# the VAD's speech_started — before any words exist — so "okay" and "stop" are
# the same event and there is nothing to filter on. Spoken replies are capped at
# a couple of sentences anyway, so there is little to interrupt.
# Accepts 1/true/yes/on and 0/false/no/off (case-insensitive).
# export INTERRUPT_RESPONSE=true

# --- Memory ceiling (supervised restart + pushgateway telemetry) ---
#
# The launcher samples each component's phys_footprint (never ps RSS, which
# reads ~20x low for MPS/MLX processes), pushes each sample to the pushgateway,
# and TERMs a component that exceeds its cap — launchd then restarts it fresh.
# Defaults are already sane (s2s 12 GB, transcriber 4 GB, shim/bot 2 GB), so
# nothing needs setting for the ceiling to exist. Override per component here:
# export MEMORY_CAP_MB_s2s=12288
# export MEMORY_CAP_MB_transcriber=4096
# export MEMORY_CAP_MB_shim=2048
# export MEMORY_CAP_MB_bot=2048
# export MEMORY_SAMPLE_INTERVAL=60
#
# Pushgateway telemetry is off unless PUSHGATEWAY_PASSWORD_KEY is set — the
# TeamVault key id for the nukeprod monitoring basic-auth password (username
# `monitoring`). The cap is enforced regardless; telemetry failure never takes
# the ceiling down.
# export PUSHGATEWAY_PASSWORD_KEY=zL8nyw
# export PUSHGATEWAY_URL=https://pushgateway.prod.nuke.benjamin-borbe.de
# export PUSHGATEWAY_USERNAME=monitoring
